# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Cloud Run service URL.
APP_URL="MY_APP_URL"

# Firebase Cloud Project configuration
FIREBASE_PROJECT_ID="ai-studio-ea8ff412-651d-4d93-9ef2-360585997684"

# Port on which the Express dev server and Cloud Run container listen
DEFAULT_APP_PORT="3000"

# CORS Origin Allow-List (comma separated)
ALLOWED_ORIGINS="https://ais-pre-lifixcjcpseyodtgecoue2-734012312881.asia-southeast1.run.app,https://ais-dev-lifixcjcpseyodtgecoue2-734012312881.asia-southeast1.run.app,http://localhost:3000"

# Logging configuration ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL="info"

# Explicit Sandbox / Demo Mode Toggle ('true' | 'false')
VITE_DEMO_MODE="false"
